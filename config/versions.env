# Источники и версии сборки. Правится здесь, workflow ничего не хардкодит.
# Любое значение можно переопределить входными параметрами workflow_dispatch.

# ─── База GKI ────────────────────────────────────────────────────────────────
# Ветка манифеста AOSP и точный коммит common/, соответствующий целевой прошивке.
#
# Коммит вытаскивается прямо из строки версии стокового ядра:
#   6.6.118-android15-8-ge56cf6b09cca-ab15511674-4k
#                        ^^^^^^^^^^^^ -> e56cf6b09cca
# Строка лежит внутри стокового boot.img, достать так:
#   scripts/stock-kernel-string.sh <boot.img>
GKI_MANIFEST_URL="${GKI_MANIFEST_URL:-https://android.googlesource.com/kernel/manifest}"
GKI_MANIFEST_BRANCH="${GKI_MANIFEST_BRANCH:-common-android15-6.6}"

# HyperOS OS3.0.302.0.WOAMIXM -> 6.6.118
GKI_COMMON_REF="${GKI_COMMON_REF:-e56cf6b09cca}"
KERNEL_BASE_VERSION="${KERNEL_BASE_VERSION:-6.6.118}"

# Предыдущая проверенная база (OS3.0.301.0.WOAMIXM -> 6.6.77):
#   GKI_COMMON_REF="63ce7556864ce3d8dcc0e8e934695347636b30bc"
#   KERNEL_BASE_VERSION="6.6.77"

# ─── KernelSU-Next ───────────────────────────────────────────────────────────
KSU_NEXT_REPO="${KSU_NEXT_REPO:-https://github.com/KernelSU-Next/KernelSU-Next}"
KSU_NEXT_REF="${KSU_NEXT_REF:-next}"
# Подставляется в kernel/Kbuild: при сборке из tarball git-метаданных нет,
# и без этого версия определяется как 1, а тег как v0.0.1.
KSU_VERSION_FALLBACK="${KSU_VERSION_FALLBACK:-33214}"
KSU_VERSION_TAG_FALLBACK="${KSU_VERSION_TAG_FALLBACK:-v3.3.0-dev-susfs}"

# ─── susfs4ksu ───────────────────────────────────────────────────────────────
SUSFS_REPO="${SUSFS_REPO:-https://gitlab.com/simonpunk/susfs4ksu}"
SUSFS_REF="${SUSFS_REF:-gki-android15-6.6}"

# ─── Брендирование ───────────────────────────────────────────────────────────
# Суффикс kernel release. Kleaf без git-стампа пишет "-maybe-dirty";
# сюда подставляется "-<KERNEL_SUFFIX_BASE>-<вариант>".
KERNEL_SUFFIX_BASE="${KERNEL_SUFFIX_BASE:-xuanyuan}"

# ─── boot.img ────────────────────────────────────────────────────────────────
# КРИТИЧНО. Уровень патча, объявляемый в AVB-свойстве
# com.android.build.boot.security_patch внутри boot.img.
#
# keystore привязывает ключи к этому значению, а KeyMint двигает его ТОЛЬКО
# ВВЕРХ. Прошивка образа с меньшим значением, чем то, под которым выпущены
# ключи, делает их непригодными: /data перестаёт расшифровываться с ошибкой
# TEE INVALID_ARGUMENT (-38). Понижение необратимо без сброса к заводским.
#
# Пустое значение = оставить то, что положил Kleaf (у GKI это бывает дата из
# будущего вроде 2099-12-31 или 2026-09-05 — прошивать такое опасно, ключи
# уедут в эту дату и после неё не подойдёт уже ни один образ).
#
# Значение обязано быть в формате ГГГГ-ММ-ДД: подстановка побайтовая, длина
# строки менять не должна.
BOOT_SECURITY_PATCH="${BOOT_SECURITY_PATCH:-2026-05-01}"

# ─── Сборка ──────────────────────────────────────────────────────────────────
BAZEL_TARGET="${BAZEL_TARGET:-//common:kernel_aarch64_dist}"
